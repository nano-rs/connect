{
  "name": "@nano-rs/connect",
  "version": "0.1.0",
  "description": "Onboard a data source into nano — set up an edge Vector collector and verify your logs are flowing.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "connect": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nano",
    "siem",
    "vector",
    "log-ingestion",
    "onboarding",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano-rs/connect.git"
  },
  "homepage": "https://github.com/nano-rs/connect#readme",
  "bugs": {
    "url": "https://github.com/nano-rs/connect/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
